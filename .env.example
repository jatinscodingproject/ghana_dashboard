# Copy to .env and fill in your actual values. Never commit .env.
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=mtn_ghana

# Optional reverse proxy support; set true only if deployed behind a trusted proxy.
TRUST_PROXY=false

# Optional: create this admin on first launch only (existing account is never overwritten).
# Use a strong password of at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD= Admin@123123
